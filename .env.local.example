# ---------------------------------------------------------------------------
# Renderbar Studios — environment variables
# Copy this file to .env.local (gitignored) and fill in real values.
# In production, set the same vars in Vercel → Settings → Environment Variables.
# The build compiles WITHOUT these; they are only read at runtime by the
# server-side Zoho integration (lib/zoho.ts).
# ---------------------------------------------------------------------------

# Public site URL (used for canonical URLs, sitemap, OG, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://renderbar.net

# --- Zoho CRM (server-side only — NEVER prefix these with NEXT_PUBLIC_) ------
# Create a Self Client at https://api-console.zoho.com, generate a grant token
# with scope `ZohoCRM.modules.ALL`, then exchange it for a refresh token.
# See the README "Zoho setup" section for the full one-time walkthrough.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data-center domains. Defaults below are the US data center.
#   US:        https://accounts.zoho.com     | https://www.zohoapis.com
#   EU:        https://accounts.zoho.eu      | https://www.zohoapis.eu
#   India:     https://accounts.zoho.in      | https://www.zohoapis.in
#   Australia: https://accounts.zoho.com.au  | https://www.zohoapis.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
